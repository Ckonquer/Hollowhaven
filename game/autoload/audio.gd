extends Node
## Audio manager. Buses: Master > Music, Ambience, SFX, UI. Volumes follow Settings.
## Sounds are looked up by NAME in res://assets/audio/{sfx,ui,music,ambience}/<name>.(wav|ogg)
## (generated by tools/audio/generate_all.py). Variants <name>_1, <name>_2, ... are picked at random
## (never the same variant twice in a row). Missing sounds never crash: a warning is printed once and
## the call is ignored (play_3d returns null).
##
## API (stable - other systems call these):
##   Audio.play_sfx(name, volume_db := 0.0, pitch_var := 0.06)            non-positional SFX
##   Audio.play_ui(name, volume_db := 0.0)                                  UI bus
##   Audio.play_3d(name, pos, volume_db := 0.0, pitch_var := 0.06, max_distance := 30.0) -> Node
##   Audio.play_music(name, fade := 2.0) / Audio.stop_music(fade := 2.0)
##   Audio.play_ambience(name, fade := 3.0, layer := 0) / Audio.stop_ambience(fade := 3.0, layer := -1)
##   Audio.duck_ambience(db, seconds)      temporarily lowers ambience (director "silence" event)
##   Audio.has_sound(name) -> bool
## Extras (optional): duck(bus, db, seconds, attack, release), stop_world_sounds(fade),
##   current_music(), current_ambience(layer), get_stream(name), preload_sounds(names).
##
## Behaviour notes
## * Voice limiting: each sound name has a maximum number of simultaneous voices (VOICE_LIMIT, default 4);
##   the oldest voice of that name is re-used, and identical requests closer than 35 ms are merged.
## * Pooling: non-positional and positional players are pooled children of this autoload (no node per
##   sound). play_3d returns the pooled AudioStreamPlayer3D: you may move it while the sound plays, but
##   do not free or re-parent it (if you do anyway, the pool replaces it).
## * Pause: music, UI sounds and anything requested while the tree is paused keep playing; world sounds
##   (play_sfx / play_3d started before the pause) are paused and resume afterwards. Ambience dips a
##   little while paused. Positional sounds fade out when an area unloads (Events.area_exiting), and
##   sounds still held by the pause are dropped then. Going back to the title (Game.mode "title")
##   also drops them and fades out the gameplay ambience; music is left to the title screen.
## * Music and each ambience layer crossfade (equal power) between decks driven by one fader per deck,
##   so rapid changes never fight each other.
## * Arachnophobia: spider-themed names are swapped for their non-arachnid alternatives automatically
##   (ARACHNO_ALT) in addition to whatever the caller chose.
## * Composed names (e.g. "pebble_scared", "weaver_telegraph", "step_dirt") resolve through ALIASES and
##   PREFIX_FALLBACK to the closest existing sound.

const ROOT := "res://assets/audio"
const DIRS := ["sfx", "ui", "ambience", "music"]
const EXTS := ["wav", "ogg"]
const BUSES := ["Music", "Ambience", "SFX", "UI"]
const VOLUME_KEYS := {"master_volume": "Master", "music_volume": "Music", "ambience_volume": "Ambience",
	"sfx_volume": "SFX", "ui_volume": "UI"}

const SFX_VOICES := 20
const UI_VOICES := 10
const VOICES_3D := 28
const MUSIC_DECKS := 3
const AMB_DECKS := 2
const AMB_LAYERS := 2
const DEFAULT_VOICE_LIMIT := 4
const PAUSE_AMBIENCE_DUCK_DB := -5.0
const FAR_FUTURE_MS := 1000000000

