var min_retrigger_ms: int = 35       # identical requests closer than this are merged (tests may set 0)

var _index: Dictionary = {}          # name -> Array[String] resource paths (variants listed under the base name too)
var _cache: Dictionary = {}          # resolved name -> Array[AudioStream]
var _resolved: Dictionary = {}       # requested name -> resolved name ("" = missing), per arachnophobia mode
var _warned: Dictionary = {}
var _last_start: Dictionary = {}     # resolved name -> msec
var _last_variant: Dictionary = {}   # resolved name -> index
var _sfx_voices: Array = []          # pausable world sounds (non-positional)
var _ui_voices: Array = []           # UI + anything requested while paused (never auto-paused)
var _voices_3d: Array = []           # positional world sounds
var _world_root: Node
var _music: Deck
var _amb: Array = []                 # one Deck per ambience layer
var _ducks: Array = []               # [{bus, db, t0, attack, hold, release}]
var _duck_db: Dictionary = {"Master": 0.0, "Music": 0.0, "Ambience": 0.0, "SFX": 0.0, "UI": 0.0}
var _duck_want: Dictionary = {"Master": 0.0, "Music": 0.0, "Ambience": 0.0, "SFX": 0.0, "UI": 0.0}
var _duck_active: bool = false
var _pause_duck: float = 0.0
var _world_paused: bool = false
var _paused_at: int = 0
var _arachno: bool = false
var _game: Node                      # the Game autoload (looked up lazily; may be absent in tools)
var _game_mode: String = ""          # last Game.mode seen (to notice "back to the title")
var _amb_mode: Array = []            # per ambience layer: Game.mode when it was last started


## A set of players for one music/ambience channel. Each deck has a fade position (0..1) that moves
## toward its target at its own speed; volume follows an equal-power curve, so a crossfade keeps the
## combined loudness steady and nothing ever fights over a player's volume.
class Deck extends RefCounted:
	var players: Array = []
	var gains: Array = []
	var targets: Array = []
	var speeds: Array = []
	var names: Array = []
	var trims: Array = []
	var active: int = -1

	func _init(owner: Node, bus: String, count: int, label: String) -> void:
		for i in count:
			var p := AudioStreamPlayer.new()
			p.name = "%s%d" % [label, i]
			p.bus = bus
			p.volume_db = -80.0
			owner.add_child(p)
			players.append(p)
			gains.append(0.0)
			targets.append(0.0)
			speeds.append(1.0)
			names.append("")
			trims.append(0.0)

	## Name playing (or fading in) on this channel, "" when silent or fading out.
	func current() -> String:
		if active >= 0 and float(targets[active]) > 0.0:
			return String(names[active])
		return ""

	func play(sound_name: String, stream: AudioStream, fade: float, trim_db: float) -> void:
		if current() == sound_name:
			return
		var slot := -1
		# still fading out with the same sound? bring it back instead of restarting
		for i in players.size():
			var pp: AudioStreamPlayer = players[i]
			if String(names[i]) == sound_name and float(gains[i]) > 0.0 and pp.stream == stream:
				slot = i
		if slot == -1:
			slot = 0
			for i in players.size():
				if float(gains[i]) < float(gains[slot]):
					slot = i
			var p: AudioStreamPlayer = players[slot]
			p.stop()
			p.stream = stream
			p.volume_db = -80.0
			gains[slot] = 0.0
			names[slot] = sound_name
			trims[slot] = trim_db
			p.play()
		var sp := 1.0 / maxf(fade, 0.01)
		for i in players.size():
			targets[i] = 1.0 if i == slot else 0.0
			speeds[i] = sp
		active = slot

	func stop(fade: float) -> void:
		var sp := 1.0 / maxf(fade, 0.01)
		for i in players.size():
			targets[i] = 0.0
			speeds[i] = sp
			if fade <= 0.0:
				gains[i] = 0.0
		active = -1

	func update(delta: float) -> void:
		for i in players.size():
			var g: float = gains[i]
			var t: float = targets[i]
			if g != t:
				var step: float = float(speeds[i]) * delta
				g = minf(g + step, t) if t > g else maxf(g - step, t)
				gains[i] = g
			var p: AudioStreamPlayer = players[i]
			if g <= 0.0 and t <= 0.0:
				if p.playing or p.stream != null:
					p.stop()
					p.stream = null
					names[i] = ""
				continue
			p.volume_db = linear_to_db(maxf(sin(g * PI * 0.5), 0.00001)) + float(trims[i])


# ---------------------------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------------------------

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	_build_index()
	_arachno = _setting_bool("arachnophobia")
	for i in SFX_VOICES:
		_sfx_voices.append(_new_voice(_make_player(false, "Sfx%d" % i)))
	for i in UI_VOICES:
		_ui_voices.append(_new_voice(_make_player(false, "Ui%d" % i)))
	_world_root = Node.new()
	_world_root.name = "World3D"
	add_child(_world_root)
	for i in VOICES_3D:
		_voices_3d.append(_new_voice(_make_player(true, "Pos%d" % i)))
	_music = Deck.new(self, "Music", MUSIC_DECKS, "Music")
	for l in AMB_LAYERS:
		_amb.append(Deck.new(self, "Ambience", AMB_DECKS, "Amb%d_" % l))
		_amb_mode.append("")
	Events.settings_changed.connect(_on_setting_changed)
	Events.area_exiting.connect(_on_area_exiting)
	apply_volumes()


func _setup_buses() -> void:
	for b in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, "Master")
	# Gentle limiter on master to prevent clipping.
	var master := AudioServer.get_bus_index("Master")
	var has_limiter := false
	for i in AudioServer.get_bus_effect_count(master):
		if AudioServer.get_bus_effect(master, i) is AudioEffectHardLimiter:
			has_limiter = true
	if not has_limiter:
		var lim := AudioEffectHardLimiter.new()
		lim.ceiling_db = -1.0
		AudioServer.add_bus_effect(master, lim)


## Scans the audio folders once. Works in the editor (x.wav) and in exported builds (x.wav.import).
func _build_index() -> void:
	_index.clear()
	for d in DIRS:
		var dir_path: String = ROOT.path_join(String(d))
		var da := DirAccess.open(dir_path)
		if da == null:
			continue
		for f in da.get_files():
			var file := String(f)
			if file.ends_with(".import"):
				file = file.trim_suffix(".import")
			elif file.ends_with(".remap"):
				file = file.trim_suffix(".remap")
			if not EXTS.has(file.get_extension().to_lower()):
				continue
			var stem := file.get_basename()
			var path := dir_path.path_join(file)
			_add_index(stem, path)
			var us := stem.rfind("_")
			if us > 0 and stem.substr(us + 1).is_valid_int():
				_add_index(stem.substr(0, us), path)


func _add_index(key: String, path: String) -> void:
	if not _index.has(key):
		_index[key] = []
	var arr: Array = _index[key]
	if not arr.has(path):
		arr.append(path)


func _make_player(positional: bool, node_name: String) -> Node:
	var p: Node
	if positional:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "SFX"
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p3.unit_size = 6.0
		p3.max_distance = 30.0
		p = p3
		p.name = node_name
		_world_root.add_child(p)
	else:
		var p2 := AudioStreamPlayer.new()
		p2.bus = "SFX"
		p = p2
		p.name = node_name
		add_child(p)
	return p


func _new_voice(p: Node) -> Dictionary:
	return {"p": p, "name": "", "start": -100000, "end": 0, "paused": false, "tw": null, "pos3d": p is AudioStreamPlayer3D}


# ---------------------------------------------------------------------------------------------
# Volumes & ducking
# ---------------------------------------------------------------------------------------------

func apply_volumes() -> void:
	for key in VOLUME_KEYS:
		var bus: String = VOLUME_KEYS[key]
		var extra: float = float(_duck_db.get(bus, 0.0))
		if bus == "Ambience":
			extra += _pause_duck
		_set_bus(bus, _setting_float(key, 1.0), extra)


func _set_bus(bus: String, linear: float, extra_db: float = 0.0) -> void:
	var idx := AudioServer.get_bus_index(bus)
	if idx < 0:
		return
	var l := clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, l <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(l, 0.0001)) + extra_db)


## Settings values are read defensively (a hand-edited settings file must never break audio).
func _setting_float(key: String, fallback: float) -> float:
	var v: Variant = Settings.get_value(key)
	if v is float or v is int:
		return float(v)
	return fallback


func _setting_bool(key: String) -> bool:
	var v: Variant = Settings.get_value(key)
	return v is bool and v


func _on_setting_changed(key: String) -> void:
	if key == "arachnophobia":
		_arachno = _setting_bool("arachnophobia")
		_resolved.clear()
	if VOLUME_KEYS.has(key) or key == "":
		apply_volumes()


## Temporarily lowers a bus ("Music", "Ambience", "SFX", "UI", "Master") by db (negative) for
## `seconds` (hold), with smooth attack/release. Overlapping ducks on a bus use the deepest one.
func duck(bus: String, db: float, seconds: float, attack: float = 0.4, release: float = 1.5) -> void:
	if not _duck_db.has(bus):
		return
	_ducks.append({"bus": bus, "db": minf(db, 0.0), "t0": Time.get_ticks_msec(), "attack": maxf(attack, 0.01),
		"hold": maxf(seconds, 0.0), "release": maxf(release, 0.01)})


## Director "silence": lowers the ambience for about `seconds` in total (1.5 s in, 1.5 s out).
func duck_ambience(db: float, seconds: float) -> void:
	duck("Ambience", db, maxf(seconds - 3.0, 0.5), 1.5, 1.5)


func _update_ducks(delta: float, now: int) -> void:
	var pause_target: float = PAUSE_AMBIENCE_DUCK_DB if get_tree().paused else 0.0
	if _ducks.is_empty() and not _duck_active and _pause_duck == pause_target:
		return                                   # idle: nothing to do, no allocations
	var want := _duck_want
	for bus in want:
		want[bus] = 0.0
	var keep: Array = []
	for d in _ducks:
		var t := float(now - int(d["t0"])) / 1000.0
		var a: float = d["attack"]
		var h: float = d["hold"]
		var r: float = d["release"]
		var k := 0.0
		if t < a:
			k = t / a
		elif t < a + h:
			k = 1.0
		elif t < a + h + r:
			k = 1.0 - (t - a - h) / r
		else:
			continue
		keep.append(d)
		var bus: String = d["bus"]
		want[bus] = minf(float(want[bus]), float(d["db"]) * k)
	_ducks = keep
	var changed := false
	if _pause_duck != pause_target:
		_pause_duck = move_toward(_pause_duck, pause_target, 12.0 * delta)
		changed = true
	_duck_active = false
	for bus in want:
		var w: float = want[bus]
		var c: float = _duck_db[bus]
		if w != c and (absf(w - c) > 0.005 or w == 0.0):
			_duck_db[bus] = w
			changed = true
		if w != 0.0:
			_duck_active = true
	if changed:
		apply_volumes()


## Current duck offset (dB) of a bus, including the pause dip for Ambience (for tests/debug).
func get_duck_db(bus: String) -> float:
	return float(_duck_db.get(bus, 0.0)) + (_pause_duck if bus == "Ambience" else 0.0)


# ---------------------------------------------------------------------------------------------
# Lookup
# ---------------------------------------------------------------------------------------------

## True when `name` resolves to a playable sound (aliases and arachnophobia swaps included).
## exact = true only accepts a real file (or variants) with exactly that name.
func has_sound(name: String, exact: bool = false) -> bool:
	if exact:
		return _has_files(name)
	return _resolve(name) != ""


## A random variant of a sound (for systems that run their own player), or null.
func get_stream(name: String) -> AudioStream:
	return _pick(_resolve(name), name)


## The sound a request would actually play ("" if none): aliases and arachnophobia swaps applied.
func resolve(name: String) -> String:
	return _resolve(name)


## Every sound name found on disk (base names and individual variants), sorted.
func sound_names() -> Array:
	var out: Array = _index.keys()
	out.sort()
	return out


## Loads the given sounds now (e.g. during an area load) so the first play never hitches.
func preload_sounds(names: Array) -> void:
	for n in names:
		_streams(_resolve(String(n)))


func _has_files(name: String) -> bool:
	if name == "":
		return false
	if _index.has(name):
		return not (_index[name] as Array).is_empty()
	if _index.is_empty():
		return not _probe(name).is_empty()
	return false


## Fallback when the folders could not be scanned: probe the expected paths directly.
func _probe(name: String) -> Array:
	var found: Array = []
	for d in DIRS:
		for ext in EXTS:
			var base := ROOT.path_join(String(d)).path_join(name)
			if ResourceLoader.exists("%s.%s" % [base, ext]):
				found.append("%s.%s" % [base, ext])
			for i in range(1, 9):
				var v := "%s_%d.%s" % [base, i, ext]
				if ResourceLoader.exists(v):
					found.append(v)
	return found


func _alt(name: String) -> String:
	if _arachno and ARACHNO_ALT.has(name) and _has_files(String(ARACHNO_ALT[name])):
		return String(ARACHNO_ALT[name])
	return name


func _alias(name: String) -> String:
	if ALIASES.has(name):
		return String(ALIASES[name])
	if PREFIX_FALLBACK.has(name):              # a bare voice prefix (data/enemies.gd "sound": "gloomling")
		return String((PREFIX_FALLBACK[name] as Dictionary).get("*", ""))
	var cut := name.rfind("_")
	if cut > 0:
		var prefix := name.substr(0, cut)
		var suffix := name.substr(cut + 1)
		if PREFIX_FALLBACK.has(prefix):
			var m: Dictionary = PREFIX_FALLBACK[prefix]
			return String(m.get(suffix, m.get("*", "")))
	return ""


## Requested name -> actual sound name ("" when nothing fits). Cached.
func _resolve(name: String) -> String:
	if name == "":
		return ""
	if _resolved.has(name):
		return String(_resolved[name])
	var out := ""
	var n := _alt(name)
	if _has_files(n):
		out = n
	else:
		var a := _alias(name)
		if a != "":
			a = _alt(a)
			if _has_files(a):
				out = a
	_resolved[name] = out
	return out


func _base(name: String) -> String:
	var us := name.rfind("_")
	if us > 0 and name.substr(us + 1).is_valid_int():
		return name.substr(0, us)
	return name


func _streams(resolved: String) -> Array:
	if resolved == "":
		return []
	if _cache.has(resolved):
		return _cache[resolved]
	var paths: Array = _index.get(resolved, []) if not _index.is_empty() else _probe(resolved)
	var found: Array = []
	for path in paths:
		var s: Resource = load(String(path))
		if s is AudioStream:
			found.append(s)
	_cache[resolved] = found
	return found


func _pick(resolved: String, requested: String) -> AudioStream:
	var arr := _streams(resolved)
	if arr.is_empty():
		if requested != "" and not _warned.has(requested):
			_warned[requested] = true
			push_warning("Audio: missing sound '%s'" % requested)
		return null
	if arr.size() == 1:
		return arr[0]
	var last: int = int(_last_variant.get(resolved, -1))
	var i := randi() % arr.size()
	if i == last:
		i = (i + 1 + randi() % (arr.size() - 1)) % arr.size()
	_last_variant[resolved] = i
	return arr[i]


# ---------------------------------------------------------------------------------------------
# Voices
# ---------------------------------------------------------------------------------------------

func _busy(v: Dictionary, now: int) -> bool:
	return int(v["end"]) > now or bool(v["paused"])


## Picks a voice for `sound`: the oldest voice of the same sound when its limit is reached, else a
## free voice, else the oldest voice overall. Freed players (a consumer freed a returned node) are replaced.
func _acquire(pool: Array, sound: String, now: int) -> Dictionary:
	var limit: int = int(VOICE_LIMIT.get(_base(sound), DEFAULT_VOICE_LIMIT))
	var same := 0
	var oldest_same: Dictionary = {}
	var free_v: Dictionary = {}
	var oldest: Dictionary = {}
	for v in pool:
		if not is_instance_valid(v["p"]):
			v["p"] = _make_player(bool(v["pos3d"]), "Voice%d" % randi())
			v["end"] = 0
			v["paused"] = false
		if _busy(v, now):
			if String(v["name"]) == sound:
				same += 1
				if oldest_same.is_empty() or int(v["start"]) < int(oldest_same["start"]):
					oldest_same = v
		elif free_v.is_empty():
			free_v = v
		if oldest.is_empty() or int(v["start"]) < int(oldest["start"]):
			oldest = v
	if same >= limit and not oldest_same.is_empty():
		return oldest_same
	if not free_v.is_empty():
		return free_v
	return oldest


func _is_looping(s: AudioStream) -> bool:
	if s is AudioStreamWAV:
		return (s as AudioStreamWAV).loop_mode != AudioStreamWAV.LOOP_DISABLED
	var lp: Variant = s.get("loop")
	return lp is bool and lp


func _start_voice(v: Dictionary, s: AudioStream, sound: String, bus: String, volume_db: float, pitch: float, now: int) -> void:
	var tw: Variant = v["tw"]
	if tw is Tween and (tw as Tween).is_valid():
		(tw as Tween).kill()
	v["tw"] = null
	var p: Node = v["p"]
	p.call("stop")
	p.set("stream", s)
	p.set("bus", bus)
	p.set("volume_db", volume_db)
	p.set("pitch_scale", pitch)
	p.set("stream_paused", false)
	p.call("play")
	v["name"] = sound
	v["start"] = now
	v["paused"] = false
	if _is_looping(s):
		v["end"] = now + FAR_FUTURE_MS
	else:
		v["end"] = now + int(s.get_length() / maxf(pitch, 0.05) * 1000.0) + 60


func _too_soon(sound: String, now: int) -> bool:
	var last: int = int(_last_start.get(sound, -100000))
	if now - last < min_retrigger_ms:
		return true
	_last_start[sound] = now
	return false


func _level(sound: String, volume_db: float) -> float:
	var b := _base(sound)
	var vary: float = float(VARY_DB.get(b, 0.0))
	return volume_db + float(GAIN_DB.get(b, 0.0)) + (randf_range(-vary, vary) if vary > 0.0 else 0.0)


func _pitch(pitch_var: float) -> float:
	var pv := clampf(pitch_var, 0.0, 0.5)
	return 1.0 + (randf_range(-pv, pv) if pv > 0.0 else 0.0)


func _auto_duck(sound: String) -> void:
	var b := _base(sound)
	if AUTO_DUCK.has(b):
		for d in AUTO_DUCK[b]:
			duck(String(d[0]), float(d[1]), float(d[2]))


## Number of voices currently playing `name` (resolved) - handy for tests and debugging.
func active_voices(name: String) -> int:
	var sound := _resolve(name)
	var now := Time.get_ticks_msec()
	var n := 0
	for pool in [_sfx_voices, _ui_voices, _voices_3d]:
		for v in pool:
			if String(v["name"]) == sound and _busy(v, now):
				n += 1
	return n


# ---------------------------------------------------------------------------------------------
# Public playback API
# ---------------------------------------------------------------------------------------------

func play_sfx(name: String, volume_db: float = 0.0, pitch_var: float = 0.06) -> void:
	var sound := _resolve(name)
	var s := _pick(sound, name)
	if s == null:
		return
	var now := Time.get_ticks_msec()
	if _too_soon(sound, now):
		return
	# requested while paused = UI context (e.g. a menu action): play it now, on a never-paused voice
	var pool: Array = _ui_voices if get_tree().paused else _sfx_voices
	var v := _acquire(pool, sound, now)
	_start_voice(v, s, sound, "SFX", _level(sound, volume_db), _pitch(pitch_var), now)
	_auto_duck(sound)


func play_ui(name: String, volume_db: float = 0.0) -> void:
	var sound := _resolve(name)
	var s := _pick(sound, name)
	if s == null:
		return
	var now := Time.get_ticks_msec()
	if _too_soon(sound, now):
		return
	var v := _acquire(_ui_voices, sound, now)
	_start_voice(v, s, sound, "UI", _level(sound, volume_db), 1.0, now)
	_auto_duck(sound)


## Positional one-shot. Returns the pooled AudioStreamPlayer3D (valid while the sound plays) or null.
func play_3d(name: String, pos: Vector3, volume_db: float = 0.0, pitch_var: float = 0.06, max_distance: float = 30.0) -> Node:
	var sound := _resolve(name)
	var s := _pick(sound, name)
	if s == null:
		return null
	if not is_inside_tree():
		return null
	var now := Time.get_ticks_msec()
	if _too_soon(sound, now):
		return null
	var v := _acquire(_voices_3d, sound, now)
	var p: AudioStreamPlayer3D = v["p"]
	p.max_distance = maxf(max_distance, 1.0)
	p.unit_size = clampf(max_distance / 5.0, 2.0, 10.0)
	p.global_position = pos
	_start_voice(v, s, sound, "SFX", _level(sound, volume_db), _pitch(pitch_var), now)
	_auto_duck(sound)
	return p


## Fades out positional sounds (and optionally the non-positional world sounds too).
func stop_world_sounds(fade: float = 0.3, include_non_positional: bool = false) -> void:
	var now := Time.get_ticks_msec()
	var pools: Array = [_voices_3d]
	if include_non_positional:
		pools.append(_sfx_voices)
	for pool in pools:
		for v in pool:
			if not _busy(v, now) or not is_instance_valid(v["p"]):
				continue
			var p: Node = v["p"]
			var tw0: Variant = v["tw"]
			if tw0 is Tween and (tw0 as Tween).is_valid():
				(tw0 as Tween).kill()
			if fade <= 0.0:
				p.call("stop")
				v["end"] = now
				v["paused"] = false
				continue
			var tw := create_tween()
			tw.tween_property(p, "volume_db", -60.0, fade)
			tw.tween_callback(Callable(p, "stop"))
			v["tw"] = tw
			v["end"] = now + int(fade * 1000.0) + 20
			v["paused"] = false
			p.set("stream_paused", false)


## Stops everything immediately (every voice, music and ambience). Used on shutdown and by tests.
func stop_all() -> void:
	for pool in [_sfx_voices, _ui_voices, _voices_3d]:
		for v in pool:
			var tw: Variant = v["tw"]
			if tw is Tween and (tw as Tween).is_valid():
				(tw as Tween).kill()
			v["tw"] = null
			v["end"] = 0
			v["paused"] = false
			if is_instance_valid(v["p"]):
				var p: Node = v["p"]
				p.call("stop")
				p.set("stream", null)
	_music.stop(0.0)
	_music.update(0.0)
	for d in _amb:
		(d as Deck).stop(0.0)
		(d as Deck).update(0.0)


func _exit_tree() -> void:
	stop_all()


func play_music(name: String, fade: float = 2.0) -> void:
	if name == "":
		stop_music(fade)
		return
	if _music.current() == name:
		return
	var s := _pick(_resolve(name), name)
	if s == null:
		_music.stop(fade)
		return
	_music.play(name, s, fade, 0.0)


func stop_music(fade: float = 2.0) -> void:
	_music.stop(fade)


func current_music() -> String:
	return _music.current()


func play_ambience(name: String, fade: float = 3.0, layer: int = 0) -> void:
	var li := clampi(layer, 0, AMB_LAYERS - 1)
	var deck: Deck = _amb[li]
	if name == "":
		deck.stop(fade)
		return
	_amb_mode[li] = _read_game_mode()
	if deck.current() == name:
		return
	var s := _pick(_resolve(name), name)
	if s == null:
		deck.stop(fade)
		return
	deck.play(name, s, fade, 0.0)


func stop_ambience(fade: float = 3.0, layer: int = -1) -> void:
	for i in AMB_LAYERS:
		if layer == -1 or layer == i:
			(_amb[i] as Deck).stop(fade)


func current_ambience(layer: int = 0) -> String:
	return (_amb[clampi(layer, 0, AMB_LAYERS - 1)] as Deck).current()


# ---------------------------------------------------------------------------------------------
# Per-frame: fades, ducking, pause
# ---------------------------------------------------------------------------------------------

func _process(delta: float) -> void:
	var now := Time.get_ticks_msec()
	var mode := _read_game_mode()
	if mode != _game_mode:
		_game_mode = mode
		if mode == "title":
			_back_to_title()            # before the pause logic below could resume held sounds
	_music.update(delta)
	for d in _amb:
		(d as Deck).update(delta)
	var paused := get_tree().paused
	if paused != _world_paused:
		_set_world_paused(paused, now)
	elif paused:
		_hold_paused()
	_update_ducks(delta, now)


## Game.mode ("boot", "title", "playing", ...), or "" when the Game autoload is not there.
func _read_game_mode() -> String:
	if not is_instance_valid(_game):
		_game = get_node_or_null("/root/Game")
		if _game == null:
			return ""
	var m: Variant = _game.get("mode")
	return String(m) if m is String else ""


## Stops world sounds that the pause is holding: their context is gone (area change, back to title),
## so they must not resume afterwards. They are silent while held, so stopping them cannot click.
func _drop_held_voices() -> void:
	var now := Time.get_ticks_msec()
	for pool in [_sfx_voices, _voices_3d]:
		for v in pool:
			if not bool(v["paused"]):
				continue
			var tw: Variant = v["tw"]
			if tw is Tween and (tw as Tween).is_valid():
				(tw as Tween).kill()
			v["tw"] = null
			v["paused"] = false
			v["end"] = now
			if is_instance_valid(v["p"]):
				(v["p"] as Node).call("stop")


func _on_area_exiting(_area: String) -> void:
	_drop_held_voices()
	stop_world_sounds(0.3)


## "Quit to title" (Game.goto_title) unpauses and changes scene without Events.area_exiting: without
## this, sounds held by the pause menu resumed over the title and the area's ambience (mine drone,
## boss bed...) kept playing under the title theme. Ambience started while already on the title stays.
func _back_to_title() -> void:
	_drop_held_voices()
	stop_world_sounds(0.3)
	for i in AMB_LAYERS:
		if String(_amb_mode[i]) != "title":
			(_amb[i] as Deck).stop(1.5)


## A positional player only registers its playback on the next physics tick after play(), so a
## pause that lands in between would not stick. While paused, keep re-asserting it.
func _hold_paused() -> void:
	for pool in [_sfx_voices, _voices_3d]:
		for v in pool:
			if bool(v["paused"]) and is_instance_valid(v["p"]):
				var p: Node = v["p"]
				if not bool(p.get("stream_paused")):
					p.set("stream_paused", true)


## Pauses (or resumes) world sounds that were playing when the game paused. Sounds started while
## paused are not affected.
func _set_world_paused(paused: bool, now: int) -> void:
	_world_paused = paused
	if paused:
		_paused_at = now
	var held := now - _paused_at
	for pool in [_sfx_voices, _voices_3d]:
		for v in pool:
			if not is_instance_valid(v["p"]):
				continue
			var p: Node = v["p"]
			if paused:
				if int(v["end"]) > now:
					p.set("stream_paused", true)
					v["paused"] = true
			elif bool(v["paused"]):
				p.set("stream_paused", false)
				v["paused"] = false
				v["end"] = int(v["end"]) + held
